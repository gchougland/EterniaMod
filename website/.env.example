NODE_ENV=development
PORT=3847
PUBLIC_BASE_URL=http://127.0.0.1:3847
SESSION_SECRET=
DATABASE_URL=
HYTALE_OIDC_ISSUER=https://connect.accounts.hytale.com
HYTALE_OIDC_CLIENT_ID=
HYTALE_OIDC_CLIENT_SECRET=
HYTALE_OIDC_REDIRECT_URI=http://127.0.0.1:3847/auth/callback
# Hytale usernames that get admin access, separated by commas.
ADMIN_HYTALE_USERNAMES=
# Optional: admin profile UUIDs, if you prefer them to usernames.
ADMIN_HYTALE_UUIDS=
GAME_BRIDGE_URL=
GAME_BRIDGE_TOKEN=
TEBEX_PUBLIC_TOKEN=
# Required for Eternia basket creation; use the private API credential paired with the public token.
TEBEX_PRIVATE_KEY=
# Enable only after game delivery, webhook and provider test checkout are configured.
TEBEX_CHECKOUT_ENABLED=false
# Keep enabled checkout limited to admins during provider Test Mode.
TEBEX_CHECKOUT_ADMIN_ONLY=true
DATA_DIR=./data
HYTALE_ASSETS_DIR=./web/hytale-assets
CHROMIUM_PATH=
LOCAL_FIXTURES=false
