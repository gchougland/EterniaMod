{
 "cases": [
  {
   "name": "portal menu: travel list with own, private and other world portals",
   "steps": [
    {
     "tool": "ui_render",
     "name": "portal-travel",
     "arguments": {
      "root": "projects",
      "path": "EterniaMod/src/main/resources/Common/UI/Custom/EterniaMod/PortalPage.ui",
      "crop": "page",
      "commands": [
       {
        "type": "Set",
        "selector": "#HereIcon.ItemId",
        "data": "Teleporter"
       },
       {
        "type": "Set",
        "selector": "#HereName.TextSpans",
        "data": "Lake Dock"
       },
       {
        "type": "Set",
        "selector": "#HereOwner.TextSpans",
        "data": "Your portal"
       },
       {
        "type": "Set",
        "selector": "#HereState.TextSpans",
        "data": "Anyone can use it"
       },
       {
        "type": "Set",
        "selector": "#HereState.Style.TextColor",
        "data": "#85c5b3"
       },
       {
        "type": "Append",
        "selector": "#Tabs",
        "text": "EterniaMod/SideTabSelected.ui"
       },
       {
        "type": "Set",
        "selector": "#Tabs[0] #SideTabLabel.TextSpans",
        "data": "Travel (3)"
       },
       {
        "type": "Set",
        "selector": "#Tabs[0] #SideTabIcon.Background",
        "data": {
         "TexturePath": "EterniaMod/Icons/worlds.png"
        }
       },
       {
        "type": "Append",
        "selector": "#Tabs",
        "text": "EterniaMod/SideTab.ui"
       },
       {
        "type": "Set",
        "selector": "#Tabs[1] #SideTabLabel.TextSpans",
        "data": "Settings"
       },
       {
        "type": "Set",
        "selector": "#Tabs[1] #SideTabIcon.Background",
        "data": {
         "TexturePath": "EterniaMod/Icons/ledger.png"
        }
       },
       {
        "type": "Set",
        "selector": "#TravelPane.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#SettingsPane.Visible",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#TravelTitle.TextSpans",
        "data": "Where to?"
       },
       {
        "type": "Append",
        "selector": "#Portals",
        "text": "EterniaMod/PortalRow.ui"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PIcon.ItemId",
        "data": "Teleporter"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PName.TextSpans",
        "data": "Copper Mine"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PLine.TextSpans",
        "data": "Your portal  ·  412 blocks away"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PTag.TextSpans",
        "data": "Yours"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PGo.TextSpans",
        "data": "Travel"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PGo.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PGo.Disabled",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PForget.TextSpans",
        "data": "Forget"
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PForget.Visible",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#Portals[0] #PForget.Disabled",
        "data": true
       },
       {
        "type": "Append",
        "selector": "#Portals",
        "text": "EterniaMod/PortalRow.ui"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PIcon.ItemId",
        "data": "Teleporter"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PName.TextSpans",
        "data": "Bram's Farm"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PLine.TextSpans",
        "data": "Bram's  ·  1.2k blocks away"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PTag.TextSpans",
        "data": "Private"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PGo.TextSpans",
        "data": "Travel"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PGo.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PGo.Disabled",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PForget.TextSpans",
        "data": "Forget"
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PForget.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[1] #PForget.Disabled",
        "data": false
       },
       {
        "type": "Append",
        "selector": "#Portals",
        "text": "EterniaMod/PortalRow.ui"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PIcon.ItemId",
        "data": "Teleporter"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PName.TextSpans",
        "data": "Desert Camp"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PLine.TextSpans",
        "data": "Cass's  ·  In Wildlands"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PTag.TextSpans",
        "data": ""
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PGo.TextSpans",
        "data": "Other world"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PGo.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PGo.Disabled",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PForget.TextSpans",
        "data": "Forget"
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PForget.Visible",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#Portals[2] #PForget.Disabled",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#ListStatus.TextSpans",
        "data": "Lake Dock is now on your portal list and your map."
       },
       {
        "type": "Set",
        "selector": "#ListPrev.TextSpans",
        "data": "Earlier"
       },
       {
        "type": "Set",
        "selector": "#ListPrev.Visible",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#ListPrev.Disabled",
        "data": true
       },
       {
        "type": "Set",
        "selector": "#ListNext.TextSpans",
        "data": "More"
       },
       {
        "type": "Set",
        "selector": "#ListNext.Visible",
        "data": false
       },
       {
        "type": "Set",
        "selector": "#ListNext.Disabled",
        "data": true
       }
      ]
     },
     "expect": {
      "valid": true
     },
     "golden": "tests/hytale/golden/portal-travel.png"
    }
   ]
  },
