$T = "Theme/Citadel.ui";
Group { Anchor: (Height: 46, Bottom: 8); LayoutMode: Left;
Group { Anchor: (Width: 260, Right: 14); LayoutMode: Middle;
Label #QstName { Anchor: (Height: 22); Style: (FontSize: 15, TextColor: $T.@Text, RenderBold: true); }
Label #QstGoal { Anchor: (Height: 20); Style: (FontSize: 13, TextColor: $T.@Muted); }
}
Group { FlexWeight: 1; Anchor: (Height: 10, Top: 18, Right: 12); Padding: (Full: 1); LayoutMode: Left; Background: #45615d;
Group #QstFill { FlexWeight: 1; Background: $T.@Primary; }
Group #QstRest { FlexWeight: 1; Background: #101e22; }
}
Label #QstCount { Anchor: (Width: 60, Right: 8); Style: (FontSize: 14, TextColor: $T.@Muted, HorizontalAlignment: End, VerticalAlignment: Center); }
Label #QstReward { Anchor: (Width: 96); Style: (FontSize: 14, TextColor: $T.@Primary, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center); }
}
