$T = "Theme/Citadel.ui";
$C = "../Common.ui";
Group { FlexWeight: 1; LayoutMode: Top;
Label #SectionTitle { Anchor: (Height: 34, Bottom: 6); Style: $T.@TitleStyle; }
Label #Description { Anchor: (Height: 50, Bottom: 8); Style: $T.@DefaultLabelStyle; }
Group #Tabs { Anchor: (Height: 48, Bottom: 8); LayoutMode: Left; }
Group { FlexWeight: 1; LayoutMode: Left;
Group #Rows { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
Group #Fields { Anchor: (Width: 252, Left: 16); LayoutMode: Top;
Group #FieldOneGroup { LayoutMode: Top; Anchor: (Height: 82, Bottom: 6); Label #FieldOneLabel { Anchor: (Height: 30); Style: (...$T.@DefaultLabelStyle, VerticalAlignment: Center); } $T.@TextField #FieldOne { Anchor: (Height: 44); } }
Group #FieldTwoGroup { LayoutMode: Top; Anchor: (Height: 82, Bottom: 6); Label #FieldTwoLabel { Anchor: (Height: 30); Style: (...$T.@DefaultLabelStyle, VerticalAlignment: Center); } $T.@TextField #FieldTwo { Anchor: (Height: 44); } }
Group #FieldThreeGroup { LayoutMode: Top; Anchor: (Height: 82, Bottom: 6); Label #FieldThreeLabel { Anchor: (Height: 30); Style: (...$T.@DefaultLabelStyle, VerticalAlignment: Center); } $T.@TextField #FieldThree { Anchor: (Height: 44); } }
}

}
Label #Status { Anchor: (Height: 34, Top: 8, Bottom: 8); Style: $T.@MutedStyle; }
Group #Actions { LayoutMode: Left; Anchor: (Height: 48);
$T.@TextButton #Primary { FlexWeight: 1; Anchor: (Height: 48, Right: 10); }
$T.@SecondaryTextButton #Secondary { FlexWeight: 1; Anchor: (Height: 48, Right: 10); }
$T.@SecondaryTextButton #Tertiary { FlexWeight: 1; Anchor: (Height: 48); }
}
}
