$T = "Theme/Citadel.ui";
Group { Anchor: (Width: 208, Height: 64, Right: 12); Background: $T.@InsetSurface; Padding: (Horizontal: 18, Vertical: 12); LayoutMode: Top;
  Group { Anchor: (Height: 20); LayoutMode: Left;
    Group { Anchor: (Width: 18, Height: 18, Right: 6); Background: "Icons/coins.png"; }
    Label #WalletCoins { FlexWeight: 1; Style: (...$T.@DefaultLabelStyle, FontSize: 14, VerticalAlignment: Center); Text: "Coins: loading"; }
  }
  Group { Anchor: (Height: 20); LayoutMode: Left;
    Group { Anchor: (Width: 18, Height: 18, Right: 6); Background: "Icons/crown.png"; }
    Label #WalletCrowns { FlexWeight: 1; Style: (...$T.@DefaultLabelStyle, FontSize: 14, VerticalAlignment: Center); Text: "Crowns: loading"; }
  }
}
