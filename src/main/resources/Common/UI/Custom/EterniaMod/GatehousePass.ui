$T = "Theme/Citadel.ui";
Group { Anchor: (Width: 304); LayoutMode: Top;
Group #PassSlot { Anchor: (Height: 568, Bottom: 6); LayoutMode: Left; }
Group #PassActions { Anchor: (Width: 280, Height: 44, Left: 0); LayoutMode: Left;
$T.@TextButton #PassClaim { FlexWeight: 1; Anchor: (Height: 44, Right: 8); Text: "Claim"; }
$T.@SecondaryTextButton #PassActivate { FlexWeight: 1; Anchor: (Height: 44); Text: "Make active"; }
Group #PassEarning { FlexWeight: 1; Anchor: (Height: 44); Background: $T.@JournalInsetSurface; LayoutMode: Center;
Group { Anchor: (Width: 10, Height: 10, Top: 17, Right: 10); Background: $T.@Accent; }
Label #PassEarningText { Anchor: (Height: 44); Text: "Earning XP"; Style: (FontSize: 15, TextColor: $T.@Accent, RenderBold: true, VerticalAlignment: Center); }
}
}
}
