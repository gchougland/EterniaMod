$T = "Theme/Citadel.ui";
@SlotStyle = (
 Default: (Background: $T.@SecondarySurface),
 Hovered: (Background: $T.@PrimaryHoverSurface),
 Pressed: (Background: $T.@PrimaryPressedSurface)
);
Group { Anchor: (Height: 52); LayoutMode: Left;
 Button #Slot0 { FlexWeight: 1; Anchor: (Height: 50, Right: 3); LayoutMode: Center; Style: @SlotStyle; TextTooltipStyle: $T.@DefaultTextTooltipStyle;
  ItemIcon #Icon { Anchor: (Width: 42, Height: 42); HitTestVisible: false; }
 }
 Button #Slot1 { FlexWeight: 1; Anchor: (Height: 50, Right: 3); LayoutMode: Center; Style: @SlotStyle; TextTooltipStyle: $T.@DefaultTextTooltipStyle;
  ItemIcon #Icon { Anchor: (Width: 42, Height: 42); HitTestVisible: false; }
 }
