$T = "Theme/Citadel.ui";
Group { Anchor: (Height: 154, Bottom: 12); LayoutMode: Top;
Label #Level { Anchor: (Height: 26, Bottom: 8); Style: $T.@SubtitleStyle; }
Group { FlexWeight: 1; LayoutMode: Left;
Group { FlexWeight: 1; Anchor: (Right: 12); Background: $T.@HeaderSurface; Padding: (Full: 12); LayoutMode: Top; Label { Anchor: (Height: 22); Style: (...$T.@MutedStyle, TextColor: $T.@Accent); Text: "FREE TRACK"; } Label #FreeName { Anchor: (Height: 34, Bottom: 6); Style: $T.@DefaultLabelStyle; } $T.@SecondaryTextButton #FreeAction { Anchor: (Height: 34); } }
Group { FlexWeight: 1; Anchor: (Right: 12); Background: $T.@HeaderSurface; Padding: (Full: 12); LayoutMode: Top; Label { Anchor: (Height: 22); Style: (...$T.@MutedStyle, TextColor: $T.@Primary); Text: "PAID TRACK"; } Label #PaidName { Anchor: (Height: 34, Bottom: 6); Style: $T.@DefaultLabelStyle; } $T.@SecondaryTextButton #PaidAction { Anchor: (Height: 34); } }
}
}
