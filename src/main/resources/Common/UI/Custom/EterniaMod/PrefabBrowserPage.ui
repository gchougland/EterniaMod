$T = "Theme/Citadel.ui";
$C = "../Common.ui";
$Browser = "../Pages/PrefabBrowser.ui";

$T.@PageOverlay {
  Anchor: (Top: 130);
  Background: #000000(0.15);
}

Group #PrefabGroup {
  Anchor: (Height: 700);
  LayoutMode: Center;

  $T.@Container {
    Anchor: (Width: 600, Height: 700);

    #Title {
      $T.@HomeButton #MenuHome { Anchor: (Right: 0, Top: 2, Width: 44, Height: 44); }
      Label #BrowserTitle {
        Anchor: (Right: 54);
        Style: (...$T.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;

      Label #CurrentPath {
        Anchor: (Bottom: 8, Horizontal: 4);
        Style: (...$T.@DefaultLabelStyle, FontSize: 12, TextColor: #b5c3b8);
        Text: "";
      }

      $Browser.@PrefabBrowserContent {
        FlexWeight: 1;
      }

      Label #StatusText {
        Anchor: (Top: 4, Bottom: 4, Horizontal: 4);
        Style: (...$T.@DefaultLabelStyle, FontSize: 13, TextColor: #b5c3b8, Wrap: true);
        Text: "";
        Visible: false;
      }

      Group #ActionRow {
        LayoutMode: Left;
        Anchor: (Top: 8, Height: 36);

        $T.@TextButton #CreatePropButton {
          Text: "";
          Anchor: (Right: 8, Height: 36);
          FlexWeight: 1;
          Visible: false;
        }

        $T.@TextButton #CreateBuildingButton {
          Text: "";
          Anchor: (Height: 36);
          FlexWeight: 1;
          Visible: false;
        }
      }
    }
  }

  $T.@Container #PreviewBackdrop {
    Anchor: (Left: 10, Top: 0, Width: 600, Height: 700);
    Visible: true;

    #Title {
      Label #PreviewTitle {
        Style: (...$T.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Full;

      PrefabPreviewComponent #PrefabPreview {
        AllowDragYaw: true;
        AllowDragPitch: true;
        AllowZoom: true;
        AllowPan: true;
        ShowAnchor: true;
      }
    }
  }
}

$C.@BackButton {}
