$T = "Theme/Citadel.ui";
@Card = Group {
  FlexWeight: 1; Background: $T.@CodexCardSurface; Padding: (Full: 18); LayoutMode: Left;
  Group { Anchor: (Width: 150, Right: 20); Background: $T.@JournalInsetSurface; LayoutMode: Middle;
    Group #Art { Anchor: (Width: 104, Height: 104); }
  }
  Group { FlexWeight: 1; LayoutMode: Top;
    Label #Name { Anchor: (Height: 30); Style: (...$T.@SubtitleStyle, FontSize: 19); }
    Label #Detail { FlexWeight: 1; Anchor: (Bottom: 8); Style: (...$T.@MutedStyle, FontSize: 15); }
    $T.@TextButton #Open { Anchor: (Height: 44); }
  }
};
$T.@CodexScreen {
  $T.@CodexTopBar {
    $T.@CodexEmblem { Group { Anchor: (Width: 44, Height: 44); Background: "Icons/ledger.png"; } }
    Group { FlexWeight: 1; LayoutMode: Middle;
      Label { Anchor: (Height: 34); Text: "Architect's Ledger"; Style: $T.@CodexTitleStyle; }
      Label { Anchor: (Height: 22); Text: "Your homes and land"; Style: $T.@CodexKickerStyle; }
    }
    Group #CurrencyWallet { Anchor: (Width: 220, Height: 64, Top: 20, Right: 12); LayoutMode: Left; }
    Group { Anchor: (Width: 54, Height: 104); Padding: (Top: 30, Right: 10); LayoutMode: Top; $T.@HomeButton #MenuHome { TooltipText: "Open your Journal"; } }
    $T.@CodexClose #Close {}
  }
  $T.@CodexBody {
    $T.@CodexPanel { Anchor: (Width: 380, Right: 24); Padding: (Full: 24);
      Group { Anchor: (Width: 64, Height: 64, Left: 0, Bottom: 16); Background: "Icons/ledger.png"; }
      Label { Anchor: (Height: 40, Bottom: 4); Text: "A place to call your own"; Style: (...$T.@TitleStyle, FontSize: 24); }
      Label { Anchor: (Height: 76, Bottom: 14); Text: "Plan your home, fill it with treasures, and build a neighbourhood together."; Style: (...$T.@DefaultLabelStyle, FontSize: 16, TextColor: $T.@Muted); }
      Group { FlexWeight: 1; }
      Label #Note { Anchor: (Height: 150); Background: $T.@JournalInsetSurface; Padding: (Full: 16); Style: (...$T.@MutedStyle, FontSize: 15); }
    }
    $T.@CodexPanel { FlexWeight: 1;
      Group { FlexWeight: 1; Anchor: (Bottom: 14); LayoutMode: Left;
        @Card #Plots { Anchor: (Right: 14);
          #Art { Background: "Icons/plot.png"; }
          #Name { Text: "Your land"; }
          #Detail { Text: "Find your personal plot or guild estate. Review a move when you need a new view."; }
          #Open { Text: "My plots"; }
        }
        @Card #Place {
          #Art { Background: "Catalog/prop/potion_shelf/icon.png"; }
          #Name { Text: "Build and furnish"; }
          #Detail { Text: "Browse your house styles and decorations anywhere. Stand on your plot to place them."; }
          #Open { Text: "Housing inventory"; }
        }
      }
      Group { FlexWeight: 1; Anchor: (Bottom: 14); LayoutMode: Left;
        @Card #Customize { Anchor: (Right: 14);
          #Art { Background: "Icons/palette.png"; }
          #Name { Text: "The finishing touches"; }
          #Detail { Text: "Choose palettes and additions. Lay a garden path that welcomes visitors."; }
          #Open { Text: "Customize home"; }
        }
        @Card #Claim {
          #Art { Background: "Icons/housing.png"; }
          #Name { Text: "Your first foundation"; }
          #Detail { Text: "Choose a free plot, or return to the claim preview you already started."; }
          #Open { Text: "Choose a plot"; }
        }
      }
      Group { FlexWeight: 1; LayoutMode: Left;
        @Card #Guild { Anchor: (Right: 14);
          #Art { Background: "Icons/guild.png"; }
          #Name { Text: "Room for your people"; }
          #Detail { Text: "Claim a guild estate, furnish the hall, and plan your community roads."; }
          #Open { Text: "Guild estate"; }
        }
        @Card #Waygate {
          #Art { Background: "Icons/worlds.png"; }
          #Name { Text: "Home Waygate"; }
          #Detail { Text: "An unlocked Waygate works from your plot. No block needs placing. Choose where to travel."; }
          #Open { Text: "Use Waygate"; }
        }
      }
    }
  }
  $T.@CodexFooter { $T.@KeyHint { @Key = "Esc"; @Hint = "Close"; } }
}
