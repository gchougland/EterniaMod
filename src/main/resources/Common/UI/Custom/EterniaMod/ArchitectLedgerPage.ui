$T = "Theme/Citadel.ui";
@Card = Group {
  FlexWeight: 1; Background: $T.@SecondarySurface; Padding: (Full: 12); LayoutMode: Left;
  Group #Art { Anchor: (Width: 72, Height: 72, Right: 16); }
  Group { FlexWeight: 1; LayoutMode: Top;
    Label #Name { Anchor: (Height: 28); Style: $T.@SubtitleStyle; }
    Label #Detail { Anchor: (Height: 42, Bottom: 6); Style: $T.@MutedStyle; }
    $T.@SecondaryTextButton #Open { Anchor: (Height: 32); }
  }
};
$T.@PageOverlay { Anchor: (Full: 0); LayoutMode: Middle;
  Group { Anchor: (Width: 1120, Height: 760); Background: $T.@PanelSurface; Padding: (Full: 24); LayoutMode: Top;
    Group { Anchor: (Height: 64, Bottom: 12); LayoutMode: Left;
      Label { FlexWeight: 1; Text: "Architect's Ledger"; Style: $T.@TitleStyle; }
      Group #CurrencyWallet { Anchor: (Width: 220, Height: 64, Right: 12); LayoutMode: Left; }
      $T.@HomeButton #MenuHome {}
    }
    Group { Anchor: (Height: 3, Bottom: 12); Background: $T.@Primary; }
    Group { Anchor: (Height: 64, Bottom: 12); LayoutMode: Top;
      Label { Anchor: (Height: 28); Text: "A PLACE TO CALL YOUR OWN"; Style: $T.@SubtitleStyle; }
      Label { Anchor: (Height: 30); Text: "Plan your home, fill it with treasures, and build a neighborhood together."; Style: $T.@DefaultLabelStyle; }
    }
    Group { Anchor: (Height: 140, Bottom: 8); LayoutMode: Left;
      @Card #Plots { Anchor: (Right: 12);
        #Art { Background: "Icons/plot.png"; }
        #Name { Text: "YOUR LAND"; }
        #Detail { Text: "Find your personal plot or guild estate. Review a move when you need a new view."; }
        #Open { Text: "My plots"; }
      }
      @Card #Place {
        #Art { Background: "Catalog/prop/potion_shelf/icon.png"; }
        #Name { Text: "BUILD & FURNISH"; }
        #Detail { Text: "Browse your house styles and decorations anywhere. Stand on your plot to place them."; }
        #Open { Text: "Housing inventory"; }
      }
    }
    Group { Anchor: (Height: 140, Bottom: 8); LayoutMode: Left;
      @Card #Customize { Anchor: (Right: 12);
        #Art { Background: "Icons/palette.png"; }
        #Name { Text: "THE FINISHING TOUCHES"; }
        #Detail { Text: "Choose palettes and additions. Lay a garden path that welcomes visitors."; }
        #Open { Text: "Customize home"; }
      }
      @Card #Claim {
        #Art { Background: "Icons/housing.png"; }
        #Name { Text: "YOUR FIRST FOUNDATION"; }
        #Detail { Text: "Choose a free plot, or return to the claim preview you already started."; }
        #Open { Text: "Choose a plot"; }
      }
    }
    Group { Anchor: (Height: 140, Bottom: 8); LayoutMode: Left;
      @Card #Guild { Anchor: (Right: 12);
        #Art { Background: "Icons/guild.png"; }
        #Name { Text: "ROOM FOR YOUR PEOPLE"; }
        #Detail { Text: "Claim a guild estate, furnish the hall, and plan your community roads."; }
        #Open { Text: "Guild estate"; }
      }
      @Card #Waygate {
        #Art { Background: "Icons/worlds.png"; }
        #Name { Text: "HOME WAYGATE"; }
        #Detail { Text: "An unlocked Waygate works from your plot. No block needs placing. Choose where to travel."; }
        #Open { Text: "Use Waygate"; }
      }
    }
    Label #Note { FlexWeight: 1; Style: $T.@MutedStyle; }
    Group { Anchor: (Height: 40); LayoutMode: Right;
      $T.@SecondaryTextButton #Close { Anchor: (Width: 132, Height: 40); Text: "Close"; }
    }
  }
}
