$T = "Theme/Citadel.ui";
$C = "../Common.ui";
Group {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: #101e22(0.7);
  Group { Anchor: (Width: 1120, Height: 760); Background: $T.@PanelSurface; Padding: (Full: 24); LayoutMode: Top;
    Group { Anchor: (Height: 64); LayoutMode: Left;
      Group { Anchor: (Width: 52, Height: 52, Right: 16); Background: (TexturePath: "Icons/crown.png"); }
      Group { FlexWeight: 1; LayoutMode: Top;
        Label { Anchor: (Height: 32); Text: "The Crown Store"; Style: $T.@TitleStyle; }
        Label { Anchor: (Height: 26); Text: "A little more you."; Style: $T.@MutedStyle; }
      }
      Group #CurrencyWallet { Anchor: (Width: 220, Height: 44); LayoutMode: Left; }
      $T.@SecondaryTextButton #Refresh { Anchor: (Width: 112, Right: 12); Text: "Refresh"; }
      $T.@TextButton #GetCrowns { Anchor: (Width: 180, Right: 12); Text: "Get Crowns"; }
      $T.@HomeButton #MenuHome {}
    }
    Group { Anchor: (Height: 3, Bottom: 12); Background: #d8b66b; }
    Label #Notice { Anchor: (Height: 58); Style: $T.@DefaultLabelStyle; }
    Group { FlexWeight: 1; LayoutMode: Left;
      Group #Categories { Anchor: (Width: 184, Right: 20); LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
      Group { FlexWeight: 1;
        Group #Catalog { Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Top;
          Group #Cards { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
          Group #PageControls { Anchor: (Height: 44); LayoutMode: Left;
            $T.@SecondaryTextButton #Previous { Anchor: (Width: 168); Text: "Previous"; }
            Label #Pagination { FlexWeight: 1; Style: (...$T.@MutedStyle, HorizontalAlignment: Center, VerticalAlignment: Center); }
            $T.@SecondaryTextButton #Next { Anchor: (Width: 168); Text: "Next"; }
          }
        }
        Group #ConfirmView { Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: $T.@SecondarySurface; Padding: (Full: 28); LayoutMode: Top;
          Group #PurchaseDetails { FlexWeight: 1; Anchor: (Bottom: 12); LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Label { Anchor: (Height: 36); Text: "YOUR NEXT FIND"; Style: $T.@SubtitleStyle; }
          Label #SelectedName { Anchor: (Height: 58); Style: (...$T.@TitleStyle, Wrap: true); }
          Group #SelectedImage { Anchor: (Width: 384, Height: 240, Bottom: 16); }
          Label #SelectedDescription { Anchor: (Height: 100); Style: $T.@DefaultLabelStyle; }
          Group { Anchor: (Height: 126); LayoutMode: Left; Group { Anchor: (Width: 30, Height: 30, Right: 10); Background: "Icons/crown.png"; } Label #SelectedPrice { FlexWeight: 1; Style: (...$T.@DefaultLabelStyle, FontSize: 20); } }
          Label { Anchor: (Height: 70); Text: "Your item is delivered immediately. Crowns are separate from the coins used in player shops."; Style: $T.@MutedStyle; }
          }
          Group { Anchor: (Height: 48); LayoutMode: Left;
            $T.@SecondaryTextButton #Back { Anchor: (Width: 200, Right: 16); Text: "Keep browsing"; }
            $T.@TextButton #Purchase { Anchor: (Width: 220); Text: "Confirm purchase"; }
          }
        }
      }
    }
    Group { Anchor: (Height: 44); LayoutMode: Right;
      $T.@SecondaryTextButton #Close { Anchor: (Width: 168); Text: "Close"; }
    }
  }
}
