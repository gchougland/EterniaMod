$T = "Theme/Citadel.ui";
$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@IconLbl = (
  FontSize: 6,
  TextColor: #ffffff(0.01),
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

// Darker = hovered, darkest = pressed (tint via PatchStyle Color).
@IconUpStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconDownStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconBackStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconFwdStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconMinusStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconPlusStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconRotStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: #192d31, LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconZoomOutStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #b5c3b8(0.85)), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconZoomInStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #85c5b3), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #d8b66b), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #b5c3b8(0.85)), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);

@SummaryLabelStyle = (
  FontSize: 18,
  TextColor: #f0e8d5,
  RenderBold: true,
  Wrap: true,
  HorizontalAlignment: Start
);

@MutedBodyStyle = (
  FontSize: 14,
  TextColor: $T.@Muted,
  Wrap: true,
  HorizontalAlignment: Start
);

$T.@PageOverlay {
  LayoutMode: Top;
  Anchor: (Left: 16, Top: 28, Bottom: 80, Width: 480);

  $T.@Container {
    FlexWeight: 1;
    Anchor: (Width: 480, Top: 0, Bottom: 0);

    #Title {
      $T.@HomeButton #MenuHome { Anchor: (Right: 0, Top: 2, Width: 44, Height: 44); }
      Label #PlotPlacementTitle {
        Anchor: (Right: 54);
        Style: (...$T.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Anchor: (Top: $T.@TitleHeight, Bottom: 0);
      Padding: (Top: 14, Left: 14, Right: 14, Bottom: 44);

      Label #Summary {
        Anchor: (Bottom: 12, Width: 448);
        Style: (...@SummaryLabelStyle);
      }

      Label #Details {
        Anchor: (Bottom: 10, Width: 448);
        Style: (...@MutedBodyStyle);
      }

      Group #TipsRows {
        Anchor: (Bottom: 14, Width: 448);
        LayoutMode: Top;
      }

      Label #PlotTypeLabel {
        Anchor: (Bottom: 6);
        Style: (...$T.@SubtitleStyle);
        Text: "";
        Visible: false;
      }

      $T.@DropdownBox #PlotTypeDropdown {
        Anchor: (Bottom: 12, Width: 448, Height: $C.@DropdownBoxHeight);
        Visible: false;
      }

      Group #BirdsEyeToggle {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        $T.@CheckBox #CheckBox {
        }

        Label #BirdsEyeLabel {
          Text: "";
          TextTooltipStyle: $T.@DefaultTextTooltipStyle;
          Anchor: (Right: 30, Left: 11);
          Style: (...$T.@DefaultLabelStyle, VerticalAlignment: Center);
        }
      }

      Group #BirdsEyeZoomRow {
        LayoutMode: Left;
        Anchor: (Bottom: 10);
        Visible: false;

        TextButton #BtnZoomIn {
          Style: @IconZoomInStyle;
          TextTooltipStyle: $T.@DefaultTextTooltipStyle;
          Anchor: (Width: 34, Height: 34, Right: 6);
          Padding: (Full: 0);
          Text: ".";
        }

        $T.@FloatSlider #BirdsEyeDistanceSlider {
          Anchor: (Width: 200, Height: 5, Right: 8);
          Min: 12.0;
          Max: 48.0;
          Value: 20.0;
        }

        TextButton #BtnZoomOut {
          Style: @IconZoomOutStyle;
          TextTooltipStyle: $T.@DefaultTextTooltipStyle;
          Anchor: (Width: 34, Height: 34, Right: 8);
          Padding: (Full: 0);
          Text: ".";
        }

        Label #BirdsEyeDistanceValue {
          Anchor: (Width: 34);
          Style: (...$T.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "20";
        }
      }

      // Bird's-eye: pan (camera) | plot move side by side. First-person: only plot column (full width).
      Group #CameraPlotRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Group #BirdsEyePanColumn {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            TextButton #BtnPanZm {
              Style: @IconUpStyle;
              TextTooltipStyle: $T.@DefaultTextTooltipStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            Group {
              LayoutMode: Left;
              TextButton #BtnPanXm {
                Style: @IconBackStyle;
                TextTooltipStyle: $T.@DefaultTextTooltipStyle;
                Anchor: (Width: 44, Height: 40);
                Padding: (Full: 0);
                Text: ".";
              }
              AssetImage #CameraPadIcon {
                Anchor: (Width: 36, Height: 36, Left: 8);
                AssetPath: "UI/Custom/camera_icon_256.png";
              }
              TextButton #BtnPanXp {
                Style: @IconFwdStyle;
                TextTooltipStyle: $T.@DefaultTextTooltipStyle;
                Anchor: (Width: 44, Height: 40, Left: 8);
                Padding: (Full: 0);
                Text: ".";
              }
            }
          }

          Group {
            LayoutMode: Center;
            TextButton #BtnPanZp {
              Style: @IconDownStyle;
              TextTooltipStyle: $T.@DefaultTextTooltipStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }
        }

        Group #PlotMovePad {
          LayoutMode: Top;
          FlexWeight: 1;

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            TextButton #BtnZm {
              Style: @IconUpStyle;
              TextTooltipStyle: $T.@DefaultTextTooltipStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            Group {
              LayoutMode: Left;
              TextButton #BtnXm {
                Style: @IconBackStyle;
                TextTooltipStyle: $T.@DefaultTextTooltipStyle;
                Anchor: (Width: 44, Height: 40);
                Padding: (Full: 0);
                Text: ".";
              }
              AssetImage #PlotPadIcon {
                Anchor: (Width: 36, Height: 36, Left: 8);
                AssetPath: "UI/Custom/house_icon_256.png";
              }
              TextButton #BtnXp {
                Style: @IconFwdStyle;
                TextTooltipStyle: $T.@DefaultTextTooltipStyle;
                Anchor: (Width: 44, Height: 40, Left: 8);
                Padding: (Full: 0);
                Text: ".";
              }
            }
          }

          Group {
            LayoutMode: Center;
            TextButton #BtnZp {
              Style: @IconDownStyle;
              TextTooltipStyle: $T.@DefaultTextTooltipStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }
        }
      }

      Label #HeightLabel {
        Anchor: (Top: 4, Bottom: 6);
        Style: (...$T.@SubtitleStyle);
        Text: "";
      }

      Group #RowYRot {
        LayoutMode: Center;
        Anchor: (Bottom: 8, Left: 0, Right: 0);
        Group {
          LayoutMode: Left;
          TextButton #BtnYm {
            Style: @IconMinusStyle;
            TextTooltipStyle: $T.@DefaultTextTooltipStyle;
            Anchor: (Width: 40, Height: 40);
            Padding: (Full: 0);
            Text: ".";
          }
          TextButton #BtnYp {
            Style: @IconPlusStyle;
            TextTooltipStyle: $T.@DefaultTextTooltipStyle;
            Anchor: (Width: 40, Height: 40, Left: 8);
            Padding: (Full: 0);
            Text: ".";
          }
          TextButton #BtnRotate {
            Style: @IconRotStyle;
            TextTooltipStyle: $T.@DefaultTextTooltipStyle;
            Anchor: (Width: 44, Height: 40, Left: 10);
            Padding: (Full: 0);
            Text: ".";
          }
        }
      }

      Group { Anchor: (Height: 36, Bottom: 10); LayoutMode: Left;
        $T.@SecondaryTextButton #FindValidPosition { Anchor: (Width: 218, Height: 36, Right: 12); Text: "Find valid spot"; }
        $T.@SecondaryTextButton #SnapToLocationButton { Anchor: (Width: 218, Height: 36); Text: "Snap to me"; }
      }

      Group {
        FlexWeight: 1;
      }

      Group #MoveConfirmGroup {
        LayoutMode: Top;
        Visible: false;
        Anchor: (Bottom: 12);

        Label #MoveConfirmText {
          Anchor: (Bottom: 10, Width: 448);
          Style: (...$T.@DefaultLabelStyle, Wrap: true, TextColor: #c49a6c, HorizontalAlignment: Start);
          Text: "";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 4);

          $T.@TextButton #MoveConfirmButton {
            Text: "";
            FlexWeight: 1;
            Anchor: (Right: 6);
          }

          $T.@TextButton #MoveConfirmBackButton {
            Text: "";
            FlexWeight: 1;
            Anchor: (Left: 6);
          }
        }
      }

      Group #RowActions {
        LayoutMode: Center;
        Anchor: (Top: 8, Left: 0, Right: 0);
        Group {
          LayoutMode: Left;
          $T.@TextButton #PlaceButton {
            Text: "";
            Anchor: (Right: 10, Width: 200, Height: 48);
            Padding: (Horizontal: 10, Vertical: 10);
          }
          $T.@CancelTextButton #CancelButton {
            Text: "";
            Anchor: (Width: 200, Height: 48);
            Padding: (Horizontal: 10, Vertical: 10);
          }
        }
      }
    }
  }
}

$C.@BackButton {}
