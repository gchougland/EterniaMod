$T = "Theme/Citadel.ui";
@Card = Group {
  FlexWeight: 1; Background: $T.@CodexCardSurface; Padding: (Full: 18); LayoutMode: Left;
  Group { Anchor: (Width: 168, Right: 20); Background: $T.@JournalInsetSurface; LayoutMode: Middle;
    Group #Art { Anchor: (Width: 120, Height: 120); }
  }
  Group { FlexWeight: 1; LayoutMode: Top;
    Label #Name { Anchor: (Height: 30); Style: (...$T.@SubtitleStyle, FontSize: 19); }
    Label #Detail { FlexWeight: 1; Anchor: (Bottom: 8); Style: (...$T.@MutedStyle, FontSize: 15); }
    $T.@TextButton #Open { Anchor: (Height: 44); }
  }
};
$T.@CodexScreen {
  $T.@CodexTopBar {
    Group { Anchor: (Width: 420); LayoutMode: Middle;
      Group { Anchor: (Width: 180, Height: 40, Left: 0); Background: "Theme/Surfaces/EterniaWordmark.png"; }
    }
    Group { FlexWeight: 1; }
    Group #CurrencyWallet { Anchor: (Width: 220, Height: 64, Top: 20, Right: 12); LayoutMode: Left; }
    Group { Anchor: (Width: 54, Height: 104); Padding: (Top: 30, Right: 10); LayoutMode: Top; $T.@HomeButton #MenuHome { TooltipText: "Open your Journal"; } }
    $T.@CodexClose #Close {}
  }
  $T.@CodexBody {
    $T.@CodexPanel { Anchor: (Width: 380, Right: 24); Padding: (Full: 24);
      Group #PageIcon { Anchor: (Width: 64, Height: 64, Left: 0, Bottom: 16); Background: "Icons/storage.png"; }
      Label #Title { Anchor: (Height: 40, Bottom: 4); Style: (...$T.@TitleStyle, FontSize: 26); }
      Label #Subtitle { Anchor: (Height: 48, Bottom: 10); Style: (...$T.@CodexKickerStyle, Wrap: true); }
      Label #Description { Anchor: (Height: 120, Bottom: 10); Style: (...$T.@DefaultLabelStyle, FontSize: 16, TextColor: $T.@Muted); }
      Label #Notice { FlexWeight: 1; Style: $T.@MutedStyle; }
      $T.@SecondaryTextButton #Back { Anchor: (Height: 48); Text: "Back"; }
    }
    $T.@CodexPanel { FlexWeight: 1;
      Group { FlexWeight: 1; Anchor: (Bottom: 14); LayoutMode: Left;
        @Card #Card0 { Anchor: (Right: 14); }
        @Card #Card1 {}
      }
      Group { FlexWeight: 1; Anchor: (Bottom: 14); LayoutMode: Left;
        @Card #Card2 { Anchor: (Right: 14); }
        @Card #Card3 {}
      }
      Group { FlexWeight: 1; Anchor: (Bottom: 14); LayoutMode: Left;
        @Card #Card4 { Anchor: (Right: 14); }
        @Card #Card5 {}
      }
      Group { Anchor: (Height: 44); LayoutMode: Left;
        $T.@SecondaryTextButton #Previous { Anchor: (Width: 160); Text: "Previous"; }
        Label #Pagination { FlexWeight: 1; Style: (...$T.@MutedStyle, HorizontalAlignment: Center, VerticalAlignment: Center); }
        $T.@SecondaryTextButton #Next { Anchor: (Width: 160); Text: "Next"; }
      }
    }
  }
  $T.@CodexFooter { $T.@KeyHint { @Key = "Esc"; @Hint = "Close"; } }
}
