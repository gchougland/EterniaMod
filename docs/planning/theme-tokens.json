  "mapping": {
    "status": "implemented-css-tokens-and-native-nine-slice",
    "cssPrefix": "--et-",
    "nativeStyleFile": "Common/UI/Custom/EterniaMod/Theme/Citadel.ui",
    "nativePolicy": "Translate semantic roles into supported .ui properties; validate with the pinned game runtime. This JSON cannot be appended as .ui.",
